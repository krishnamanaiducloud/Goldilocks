{{define "navigation"}}
<a href="{{ .BasePath }}">
  <img alt="Goldilocks" class="logo" src="{{ .BasePath }}static/images/goldilocks.svg" />
</a>

<p class="logoSupport">
  An Open Source Project by
  <a
    href="https://fairwinds.com?source=goldilocks"
    rel="noreferrer noopener"
    target="_blank"
  >
    <img
      alt="Fairwinds"
      class="logo logo--secondary"
      src="{{ .BasePath }}static/images/fw-logo.png"
    />
    <span class="visually-hidden">(Opens in new window)</span>
  </a>
  <br />
   <strong>Customized for Embark</strong>
</p>

<nav>
  <ul class="navList" role="list">
    <li>
      <a class="linkIcon" href="{{ .BasePath }}">
        <i aria-hidden="true" class="fas fa-fw fa-list-ul"></i>
        Namespaces
      </a>
    </li>
    <li>
      <a class="linkIcon" href="{{ .BasePath }}dashboard">
        <i aria-hidden="true" class="far fa-fw fa-eye"></i>
        All Details
      </a>
    </li>
    {{ if hasField .Data "VpaData" }}
    <li>
      <a class="linkIcon" href="#glossary">
        <i aria-hidden="true" class="fas fa-fw fa-book"></i>
        Glossary
      </a>
    </li>
    {{ end }}
  </ul>
</nav>

<button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle dark mode">
  <i aria-hidden="true" class="fas fa-fw fa-adjust"></i>
  <span class="theme-toggle__label">Toggle Theme</span>
</button>

{{end}}
