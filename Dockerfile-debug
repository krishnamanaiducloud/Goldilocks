############## 1. Builder Stage (Compiles the Go binary) ##############
ARG GO_IMAGE=golang:1.26.5-alpine3.24@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2

FROM ${GO_IMAGE} AS builder

WORKDIR /app

# Install git for go modules
RUN apk upgrade --no-cache \
    && apk add --no-cache git

# Copy dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source
COPY main.go ./
COPY cmd ./cmd
COPY pkg ./pkg

# Build optimized static binary
ARG VERSION=dev
ARG COMMIT=none
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG TARGETVARIANT
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOARM=${TARGETVARIANT#v} \
    go build -o goldilocks \
    -ldflags="-X main.version=${VERSION} -X main.commit=${COMMIT} -s -w" \
    main.go

# Fix permissions now (so OpenShift dynamic UID can read/execute)
RUN chmod g+rwX /app/goldilocks


############## 2. Final Image (Alpine: OpenShift + Shell) ##############
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk upgrade --no-cache

# Metadata labels
LABEL org.opencontainers.image.authors="FairwindsOps, Inc." \
      org.opencontainers.image.vendor="FairwindsOps, Inc." \
      org.opencontainers.image.title="Embark-Goldilocks" \
      org.opencontainers.image.description="Goldilocks helps identify a starting point for Kubernetes resource requests and limits. OpenShift & debug-friendly build." \
      org.opencontainers.image.documentation="https://goldilocks.docs.fairwinds.com/" \
      org.opencontainers.image.source="https://github.com/FairwindsOps/goldilocks" \
      org.opencontainers.image.url="https://github.com/FairwindsOps/goldilocks" \
      org.opencontainers.image.licenses="Apache License 2.0"

WORKDIR /

# Copy binary from builder
COPY --from=builder /app/goldilocks /goldilocks

# Optional: make /tmp writable for logs or cache
RUN mkdir -p /tmp && chmod 777 /tmp

# DO NOT set USER → let OpenShift assign random non-root UID
# USER 1001  ← remove this for OpenShift SCC compatibility

ENTRYPOINT ["/goldilocks"]

# Debug shell example:
# docker run -it --entrypoint /bin/sh <image>
