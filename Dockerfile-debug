# Debug runtime: reuse the tested production binary in a shell-capable image.
ARG PRODUCTION_IMAGE=mohankrishna999/goldilocks:v53
ARG DEBUG_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:82d42999b1bc4b2aa724b442d300194901e64563efec75b3245e41f4c09fb6d2
ARG APK_REPOSITORY=https://apk.cgr.dev/chainguard

FROM ${PRODUCTION_IMAGE} AS production
FROM ${DEBUG_IMAGE}
ARG APK_REPOSITORY

USER root
RUN printf '%s\n' "${APK_REPOSITORY}" > /etc/apk/repositories \
    && apk --timeout 60 upgrade --no-cache \
    && apk --timeout 60 add --no-cache bash ca-certificates-bundle \
    && mkdir -p /tmp \
    && chmod 1777 /tmp \
    && rm -rf /var/cache/apk/*

COPY --from=production /goldilocks /goldilocks

USER 65532:65532
ENTRYPOINT ["/goldilocks"]
