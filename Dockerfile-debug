############## 1. Builder Stage (Compiles the Go binary) ##############
ARG GO_IMAGE=cgr.dev/chainguard/go:latest-dev

FROM ${GO_IMAGE} AS builder

USER root

WORKDIR /app

# Install git for go modules
RUN apk upgrade --no-cache \
    && apk add --no-cache git

# Copy dependencies
COPY go.mod go.sum ./
RUN --mount=type=cache,id=goldilocks-go-mod,target=/go/pkg/mod,sharing=locked \
    go mod download

# Copy the rest of the source
COPY main.go ./
COPY cmd ./cmd
COPY pkg ./pkg

# Build optimized static binary
ARG VERSION=dev
ARG COMMIT=none
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG TARGETVARIANT
RUN --mount=type=cache,id=goldilocks-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=goldilocks-go-build,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOARM=${TARGETVARIANT#v} \
    go build -mod=readonly -trimpath -o goldilocks \
    -ldflags="-X main.version=${VERSION} -X main.commit=${COMMIT} -s -w" \
    main.go

# Every UID can execute the immutable binary; no runtime user can replace it.
RUN chmod 0555 /app/goldilocks


############## 2. Final Image (Alpine: OpenShift + Shell) ##############
FROM cgr.dev/chainguard/wolfi-base:latest

RUN apk upgrade --no-cache

# Metadata labels
LABEL org.opencontainers.image.authors="FairwindsOps, Inc." \
      org.opencontainers.image.vendor="FairwindsOps, Inc." \
      org.opencontainers.image.title="Embark-Goldilocks" \
      org.opencontainers.image.description="Goldilocks helps identify a starting point for Kubernetes resource requests and limits. OpenShift & debug-friendly build." \
      org.opencontainers.image.documentation="https://goldilocks.docs.fairwinds.com/" \
      org.opencontainers.image.source="https://github.com/FairwindsOps/goldilocks" \
      org.opencontainers.image.url="https://github.com/FairwindsOps/goldilocks" \
      org.opencontainers.image.licenses="Apache License 2.0"

WORKDIR /

# Copy binary from builder
COPY --from=builder /app/goldilocks /goldilocks

# Keep temporary files isolated between arbitrary runtime users.
RUN mkdir -p /tmp && chmod 1777 /tmp

# Use a secure local default. OpenShift restricted SCC can still assign its
# namespace-specific arbitrary non-root UID at runtime.
USER 65532:65532

ENTRYPOINT ["/goldilocks"]

